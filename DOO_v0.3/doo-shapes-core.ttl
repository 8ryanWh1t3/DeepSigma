@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix doo: <https://decisionoperations.org/ontology/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://decisionoperations.org/ontology/shapes/core> a owl:Ontology ; dcterms:title "DOO SHACL — Core Profile"@en ; owl:versionInfo "0.3.0-draft" .

doo:DecisionEpisodeCoreShape a sh:NodeShape ;
  sh:targetClass doo:DecisionEpisode ;
  sh:property [ sh:path doo:identifier ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Violation ; sh:message "DecisionEpisode requires an identifier."@en ] ;
  sh:property [ sh:path doo:framesProblem ; sh:minCount 1 ; sh:class doo:DecisionProblem ; sh:severity sh:Violation ; sh:message "DecisionEpisode must frame at least one DecisionProblem."@en ] ;
  sh:property [ sh:path doo:resultsInDecision ; sh:minCount 1 ; sh:class doo:Decision ; sh:severity sh:Violation ; sh:message "DecisionEpisode must result in at least one Decision."@en ] ;
  sh:property [ sh:path doo:hasParticipant ; sh:minCount 1 ; sh:class doo:Actor ; sh:severity sh:Violation ; sh:message "DecisionEpisode must identify at least one participating Actor."@en ] .

doo:DecisionCoreShape a sh:NodeShape ;
  sh:targetClass doo:Decision ;
  sh:property [ sh:path doo:identifier ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Violation ] ;
  sh:property [ sh:path doo:madeBy ; sh:minCount 1 ; sh:class doo:Actor ; sh:severity sh:Violation ; sh:message "Decision must identify who or what made the decision."@en ] ;
  sh:property [ sh:path doo:decisionTime ; sh:minCount 1 ; sh:datatype xsd:dateTime ; sh:severity sh:Violation ] ;
  sh:property [ sh:path doo:whySummary ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Portable decisions should preserve a concise why summary."@en ] ;
  sh:property [ sh:path doo:addressesProblem ; sh:minCount 1 ; sh:class doo:DecisionProblem ; sh:severity sh:Warning ] .
