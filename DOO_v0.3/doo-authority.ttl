@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix doo: <https://decisionoperations.org/ontology/core#> .

<https://decisionoperations.org/ontology/authority> a owl:Ontology ;
  dcterms:title "Decision Operations Ontology — Authority"@en ;
  dcterms:description "Authority, roles, scope, jurisdiction, approvals, constraints, and policy basis for governed decisions. DOO represents authority; it does not create or confer authority."@en ;
  owl:imports <https://decisionoperations.org/ontology/core> ; owl:versionInfo "0.3.0-draft" .

doo:Authority a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Authority"@en .
doo:AuthorityScope a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Authority Scope"@en .
doo:DecisionRole a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Decision Role"@en .
doo:Approval a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Approval"@en .
doo:Jurisdiction a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Jurisdiction"@en .
doo:Constraint a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Constraint"@en .
doo:PolicyBasis a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Policy Basis"@en .
doo:AuthorityGrant a owl:Class ; rdfs:subClassOf doo:DecisionOperationsObject ; rdfs:label "Authority Grant"@en .

doo:authorizedBy a owl:ObjectProperty ; rdfs:domain doo:Decision ; rdfs:range doo:Authority ; rdfs:label "authorized by"@en .
doo:authorizesDecision a owl:ObjectProperty ; owl:inverseOf doo:authorizedBy ; rdfs:domain doo:Authority ; rdfs:range doo:Decision ; rdfs:label "authorizes decision"@en .
doo:exercisedBy a owl:ObjectProperty ; rdfs:domain doo:Authority ; rdfs:range doo:Actor ; rdfs:label "exercised by"@en .
doo:hasAuthorityScope a owl:ObjectProperty ; rdfs:domain doo:Authority ; rdfs:range doo:AuthorityScope ; rdfs:label "has authority scope"@en .
doo:holdsRole a owl:ObjectProperty ; rdfs:domain doo:Actor ; rdfs:range doo:DecisionRole ; rdfs:label "holds role"@en .
doo:withinJurisdiction a owl:ObjectProperty ; rdfs:domain doo:Authority ; rdfs:range doo:Jurisdiction ; rdfs:label "within jurisdiction"@en .
doo:constrainedBy a owl:ObjectProperty ; rdfs:domain doo:DecisionOperationsObject ; rdfs:range doo:Constraint ; rdfs:label "constrained by"@en .
doo:basedOnPolicy a owl:ObjectProperty ; rdfs:domain doo:Authority ; rdfs:range doo:PolicyBasis ; rdfs:label "based on policy"@en .
doo:recordsApproval a owl:ObjectProperty ; rdfs:domain doo:Decision ; rdfs:range doo:Approval ; rdfs:label "records approval"@en .
doo:approvedBy a owl:ObjectProperty ; rdfs:domain doo:Approval ; rdfs:range doo:Actor ; rdfs:label "approved by"@en .
doo:grantsAuthority a owl:ObjectProperty ; rdfs:domain doo:AuthorityGrant ; rdfs:range doo:Authority ; rdfs:label "grants authority"@en .
doo:grantingSource a owl:ObjectProperty ; rdfs:domain doo:AuthorityGrant ; rdfs:range doo:PolicyBasis ; rdfs:label "granting source"@en .

doo:authorityBasisText a owl:DatatypeProperty ; rdfs:domain doo:Authority ; rdfs:range xsd:string ; rdfs:label "authority basis text"@en .
doo:approvalTime a owl:DatatypeProperty ; rdfs:domain doo:Approval ; rdfs:range xsd:dateTime ; rdfs:label "approval time"@en .
doo:jurisdictionCode a owl:DatatypeProperty ; rdfs:domain doo:Jurisdiction ; rdfs:range xsd:string ; rdfs:label "jurisdiction code"@en .
doo:scopeText a owl:DatatypeProperty ; rdfs:domain doo:AuthorityScope ; rdfs:range xsd:string ; rdfs:label "scope text"@en .
doo:constraintText a owl:DatatypeProperty ; rdfs:domain doo:Constraint ; rdfs:range xsd:string ; rdfs:label "constraint text"@en .
doo:policyLocator a owl:DatatypeProperty ; rdfs:domain doo:PolicyBasis ; rdfs:range xsd:anyURI ; rdfs:label "policy locator"@en .
