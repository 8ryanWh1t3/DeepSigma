@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix doo: <https://decisionoperations.org/ontology/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://decisionoperations.org/ontology/shapes/evidence> a owl:Ontology ; dcterms:title "DOO SHACL — Evidence Profile"@en ; owl:versionInfo "0.3.0-draft" .

doo:ClaimEvidenceShape a sh:NodeShape ; sh:targetClass doo:Claim ;
  sh:property [ sh:path doo:statementText ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Violation ] ;
  sh:property [ sh:path doo:supportedBy ; sh:minCount 1 ; sh:class doo:Evidence ; sh:severity sh:Warning ; sh:message "Claims should link to supporting evidence when available."@en ] ;
  sh:property [ sh:path doo:confidence ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:datatype xsd:decimal ; sh:severity sh:Violation ] .

doo:AssumptionEvidenceShape a sh:NodeShape ; sh:targetClass doo:Assumption ;
  sh:property [ sh:path doo:statementText ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Violation ] ;
  sh:property [ sh:path doo:confidence ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:datatype xsd:decimal ; sh:severity sh:Violation ] .

doo:EvidenceShape a sh:NodeShape ; sh:targetClass doo:Evidence ;
  sh:property [ sh:path doo:identifier ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Violation ] .
