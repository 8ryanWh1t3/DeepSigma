@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix doo: <https://decisionoperations.org/ontology/core#> .
@prefix ex: <https://example.org/decision/> .

ex:episode-001 a doo:DecisionEpisode ;
  doo:identifier "EP-001" ; doo:title "Select implementation approach" ;
  doo:framesProblem ex:problem-001 ; doo:hasOption ex:option-a, ex:option-b ;
  doo:resultsInDecision ex:decision-001 ; doo:hasParticipant ex:decision-maker .

ex:problem-001 a doo:DecisionProblem ; doo:identifier "PROB-001" ;
  doo:description "Select an implementation approach that satisfies the mission need." .
ex:option-a a doo:DecisionOption ; doo:identifier "OPT-A" ; doo:description "Integrate existing service." .
ex:option-b a doo:DecisionOption ; doo:identifier "OPT-B" ; doo:description "Build a new service." .
ex:decision-001 a doo:Decision ; doo:identifier "DEC-001" ; doo:addressesProblem ex:problem-001 ;
  doo:selectsOption ex:option-a ; doo:rejectsOption ex:option-b ; doo:madeBy ex:decision-maker ;
  doo:whySummary "Existing service meets the mission need with lower integration burden." ;
  doo:decisionTime "2026-09-27T12:00:00-04:00"^^xsd:dateTime .
ex:decision-maker a doo:HumanActor ; doo:identifier "ACTOR-001" .
