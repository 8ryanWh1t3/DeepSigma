@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix doo: <https://decisionoperations.org/ontology/core#> .
@prefix ds: <https://deepsigma.io/ontology/decision-operations#> .

<https://decisionoperations.org/migration/v0.1-to-v0.3> a owl:Ontology ; dcterms:title "DOO v0.1 to v0.3 Compatibility Mapping"@en ; owl:versionInfo "0.3.0-draft" .

ds:Decision owl:equivalentClass doo:Decision .
ds:DecisionEpisode owl:equivalentClass doo:DecisionEpisode .
ds:DecisionProblem owl:equivalentClass doo:DecisionProblem .
ds:DecisionOption owl:equivalentClass doo:DecisionOption .
ds:Claim owl:equivalentClass doo:Claim .
ds:Evidence owl:equivalentClass doo:Evidence .
ds:Assumption owl:equivalentClass doo:Assumption .
ds:Authority owl:equivalentClass doo:Authority .
ds:Action owl:equivalentClass doo:Action .
ds:Outcome owl:equivalentClass doo:Outcome .
ds:Review owl:equivalentClass doo:Review .
ds:DriftSignal owl:equivalentClass doo:DriftSignal .
ds:Patch owl:equivalentClass doo:Patch .
ds:DecisionPacket owl:equivalentClass doo:DecisionPacket .
ds:DecisionLineageRecord owl:equivalentClass doo:DecisionLineageRecord .
